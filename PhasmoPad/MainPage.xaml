<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PhasmoPad.MainPage">
    <StackLayout>
        <Image
            x:Name="EMF"
            Source="evidence_emf.png"
            HeightRequest="32"
            Aspect="AspectFit"/>
        <Image
            Source="evidence_spirit_box.png"
            HeightRequest="32"
            Aspect="AspectFit"/>
        <Image
            Source="evidence_fingerprint.png"
            HeightRequest="32"
            Aspect="AspectFit"/>
        <Image
            Source="evidence_book.png"
            HeightRequest="32"
            Aspect="AspectFit"/>
        <Image
            Source="evidence_orbs.png"
            HeightRequest="32"
            Aspect="AspectFit"/>
        <Image
            Source="evidence_dots.png"
            HeightRequest="32"
            Aspect="AspectFit"/>
        <Image
            Source="evidence_breathing.png"
            HeightRequest="32"
            Aspect="AspectFit"/>

        <Button
            x:Name="ChangeBtn"
            Text="Change Images" 
            SemanticProperties.Hint="Counts the number of times you click"
            Clicked="OnChangeClicked"
            HorizontalOptions="Fill"/>
    </StackLayout>
